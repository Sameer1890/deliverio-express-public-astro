---
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/about/", label: "About Us" },
  { href: "/contact/", label: "Contact" },
];
const portal = import.meta.env.PUBLIC_PORTAL_URL || "#";
const tracking = import.meta.env.PUBLIC_TRACKING_URL || "/#track";
---
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-message" aria-label="Latest announcement">
      <div class="topbar-track">
        <span>Logistics that move your business forward</span>
        <span aria-hidden="true">Logistics that move your business forward</span>
      </div>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Deliverio Express homepage">
      <img class="brand-emblem" src="/deliverio-emblem-transparent.png?v=20261028" alt="Deliverio Express package route icon" />
      <span class="brand-name">deliverio<span>_express</span><small>COURIER &amp; LOGISTICS</small></span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
      </div>
</header>