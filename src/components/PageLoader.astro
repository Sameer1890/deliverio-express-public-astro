<div class="delivery-loader is-active" role="status" aria-live="polite" aria-label="Deliverio Express is preparing your delivery">
  <div class="delivery-loader-content">
    <svg class="delivery-loader-scene" viewBox="0 0 360 150" aria-hidden="true">
      <path class="delivery-loader-route" d="M52 50H98C109 50 115 56 115 67V69C115 80 109 86 98 86H76C64 86 58 92 58 103V105C58 116 64 122 76 122H280" />
      <g class="delivery-loader-parcel" transform="translate(12 27)">
        <path d="M2 12 22 2l22 10v27L22 50 2 39z" fill="#0b211c" stroke="#00e6c3" stroke-width="2.5" stroke-linejoin="round" />
        <path d="m2 12 20 11 22-11M22 23v27M15 6l21 11v9" fill="none" stroke="#00e6c3" stroke-width="2" stroke-linejoin="round" />
      </g>
      <g class="delivery-loader-pin" transform="translate(294 78)">
        <path d="M24 0C10.7 0 0 10.7 0 24c0 17 24 43 24 43s24-26 24-43C48 10.7 37.3 0 24 0Z" fill="#00e6c3" />
        <circle cx="24" cy="24" r="8" fill="#061311" />
      </g>
      <defs>
        <g id="delivery-bike-art" stroke="#f5fbf9" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="-17" cy="9" r="8" fill="#061311" stroke-width="3" />
          <circle cx="17" cy="9" r="8" fill="#061311" stroke-width="3" />
          <path d="m-17 9 12-15 14 15h8M-5-6l-3 15m3-15h11l5 8" fill="none" stroke-width="3" />
          <path d="M-12 1q8-7 19-1l6 8h-24" fill="#00e6c3" stroke="#00e6c3" stroke-width="2" />
          <path d="m-5-6 3-9h8" fill="none" stroke-width="3" />
          <circle cx="0" cy="-19" r="5" fill="#00e6c3" stroke="none" />
          <path d="m0-14-4 8 10 3" fill="none" stroke-width="4" />
          <path d="M-39-14h16v12h-16z" fill="#0b211c" stroke="#00e6c3" stroke-width="2" />
          <path d="M-20-4h-4" fill="none" stroke-width="2" />
          <path d="M8-11h8" fill="none" stroke="#00e6c3" stroke-width="1.5" />
        </g>
      </defs>
      <g class="delivery-loader-bike">
        <animateMotion id="delivery-loader-ride" begin="indefinite" dur="0.4s" calcMode="spline" keyTimes="0;1" keySplines="0.42 0 0.58 1" fill="freeze" rotate="auto" path="M63 50H98C109 50 115 56 115 67V69C115 80 109 86 98 86H76C64 86 58 92 58 103V105C58 116 64 122 76 122H280" />
        <use href="#delivery-bike-art" />
      </g>
      <g class="delivery-loader-bike-static" transform="translate(180 122)">
        <use href="#delivery-bike-art" />
      </g>
    </svg>
    <p>On the way to your location</p>
    <div class="delivery-loader-progress" aria-hidden="true"><span></span></div>
  </div>
</div>
<noscript><style>.delivery-loader{display:none!important}</style></noscript>

<style is:global>
  .delivery-loader {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: radial-gradient(ellipse at center, #0b211c 0%, #061311 72%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 240ms ease, visibility 240ms ease;
  }

  .delivery-loader.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .delivery-loader-content {
    width: min(100%, 430px);
    text-align: center;
  }

  .delivery-loader-scene {
    display: block;
    width: min(100%, 360px);
    aspect-ratio: 12 / 5;
    margin: 0 auto 8px;
    overflow: visible;
  }

  .delivery-loader-route {
    fill: none;
    stroke: #00e6c3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.65;
    stroke-width: 4;
  }

  .delivery-loader-parcel {
    filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.35));
  }

  .delivery-loader-pin {
    filter: drop-shadow(0 0 12px rgba(0, 230, 195, 0.36));
  }

  .delivery-loader-bike-static {
    display: none;
  }

  .delivery-loader-content > p {
    margin: 0 0 18px;
    color: #f5fbf9;
    font: 500 0.9rem "DM Sans", sans-serif;
  }

  .delivery-loader-progress {
    width: min(100%, 250px);
    height: 3px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(210, 245, 235, 0.13);
  }

  .delivery-loader-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: #00e6c3;
    transform: scaleX(0);
    transform-origin: left;
  }

  .delivery-loader.is-active .delivery-loader-progress span {
    animation: delivery-loader-progress 400ms ease-out forwards;
  }

  @keyframes delivery-loader-progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .delivery-loader-bike {
      display: none;
    }

    .delivery-loader-bike-static {
      display: block;
    }

    .delivery-loader.is-active .delivery-loader-progress span {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  const loader = document.querySelector<HTMLElement>(".delivery-loader");
  const rideAnimation = document.querySelector<SVGAnimateMotionElement>("#delivery-loader-ride");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const travelDuration = prefersReducedMotion ? 180 : 400;
  const pendingNavigationKey = "deliverio-loader-navigation";

  const startLoader = () => {
    loader?.classList.add("is-active");
    loader?.setAttribute("aria-hidden", "false");
    if (!prefersReducedMotion) rideAnimation?.beginElement();
  };

  const hideLoader = () => {
    loader?.classList.remove("is-active");
    loader?.setAttribute("aria-hidden", "true");
  };

  const hideAfterTravel = () => window.setTimeout(hideLoader, travelDuration);

  const pendingNavigation = window.sessionStorage.getItem(pendingNavigationKey);
  const skipEntryLoader = pendingNavigation !== null && Date.now() - Number(pendingNavigation) < 10000;
  window.sessionStorage.removeItem(pendingNavigationKey);

  if (skipEntryLoader) {
    hideLoader();
  } else {
    startLoader();
    if (document.readyState === "complete") {
      hideAfterTravel();
    } else {
      window.addEventListener("load", hideAfterTravel, { once: true });
    }
  }

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) hideLoader();
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest("a[href]");
    if (!(link instanceof HTMLAnchorElement)) return;
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (link.hasAttribute("download") || (link.target && link.target !== "_self")) return;

    const destination = new URL(link.href, window.location.href);
    const isSamePage = destination.origin === window.location.origin
      && destination.pathname === window.location.pathname
      && destination.search === window.location.search;
    if (destination.origin !== window.location.origin || isSamePage) return;

    event.preventDefault();
    window.sessionStorage.setItem(pendingNavigationKey, String(Date.now()));
    startLoader();
    window.setTimeout(() => window.location.assign(destination.href), travelDuration);
  });
</script>
