---
const year = new Date().getFullYear();
const portal = import.meta.env.PUBLIC_PORTAL_URL || "#";
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="Deliverio Express homepage">
        <img class="brand-emblem" src="/deliverio-emblem.png" alt="" />
        <span class="brand-name">deliverio<span>_express</span><small>COURIER &amp; LOGISTICS</small></span>
      </a>
      <p>Helping businesses move parcels, serve customers and grow with confidence.</p>
    </div>
    <div><h2>Explore</h2><a href="/services/">Our services</a><a href="/pricing/">Pricing</a><a href="/about/">About us</a></div>
    <div><h2>Customer help</h2><a href="/contact/">Contact us</a><a href={import.meta.env.PUBLIC_TRACKING_URL || "/#track"}>Track shipment</a><a href={portal}>Seller portal</a></div>
    <div class="footer-socials"><h2>Follow us</h2><div class="social-links" aria-label="Deliverio Express social media">
      <a href="https://www.linkedin.com/company/deliverio-express" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 7.8H1.7V20h3.6V7.8ZM3.5 2A2.1 2.1 0 1 0 3.5 6.2 2.1 2.1 0 0 0 3.5 2ZM20.3 12.9c0-3.7-2-5.4-4.7-5.4-2.2 0-3.1 1.2-3.7 2V7.8H8.3V20h3.6v-6.1c0-1.6.3-3.2 2.3-3.2 2 0 2 1.8 2 3.3V20h3.6l.5-7.1Z"/></svg></a>
      <a href="https://www.facebook.com/share/19sk3SQ4eV/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.1V6.5c0-.8.5-1 1-1h2V2h-2.8C10.8 2 10 4.5 10 6v2.1H7v4h3V22h4v-9.9h3l.5-4H14Z"/></svg></a>
      <a href="https://www.instagram.com/deliverio_express?mdxt=bjlpMzVjeXNxa3Zy" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.1"/></svg></a>
      <a href="https://www.tiktok.com/@deliverio_express" target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.7 3c.3 2.1 1.4 3.5 3.3 4v3.2a7.5 7.5 0 0 1-3.3-.9V15a6.1 6.1 0 1 1-5.2-6v3.3a2.9 2.9 0 1 0 2 2.8V3h3.2Z"/></svg></a>
    </div></div>
  </div>
  <div class="container footer-bottom"><span>© {year} Deliverio Express. All rights reserved.</span><span>Fast. Thoughtful. In motion.</span></div>
</footer>