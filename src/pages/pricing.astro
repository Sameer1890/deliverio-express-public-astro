---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Courier Rates & Shipping Pricing | Deliverio Express" description="View Deliverio Express Karachi courier rates, COD handling and free-pickup offers for online sellers." canonical="/pricing/">
  <section class="page-hero"><div class="container"><p class="eyebrow">PRICING</p><h1>Clear rates.<br /><em>Better planning.</em></h1><p>Our Karachi delivery rates and seller offers, at a glance.</p></div></section>
  <section class="section"><div class="container pricing-page">
    <div class="table-wrap">
      <table class="rate-table">
        <caption>Deliverio Express rates and offers</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">Rate / details</th></tr></thead>
        <tbody>
          <tr><th scope="row">Karachi delivery (up to 1 kg)</th><td>Rs. 150</td></tr>
          <tr><th scope="row">Each extra kg</th><td>Rs. 100</td></tr>
          <tr><th scope="row">COD handling</th><td>2% (minimum Rs. 20)</td></tr>
          <tr><th scope="row">Outside Karachi</th><td>Ask for a quote on WhatsApp</td></tr>
          <tr><th scope="row">Pickup</th><td>Free with 3+ parcels</td></tr>
          <tr><th scope="row">New sellers</th><td>First 3 parcels free in Karachi</td></tr>
        </tbody>
      </table>
    </div>
    <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">Request pricing on WhatsApp <span aria-hidden="true">↗</span></a>
  </div></section>
</BaseLayout>
