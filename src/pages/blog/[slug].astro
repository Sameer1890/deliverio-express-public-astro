---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const posts = [
    {
      slug: "what-is-cod-delivery",
      category: "COD",
      title: "What is COD delivery and how does it work?",
      description: "Understand Cash on Delivery for online orders, parcel records and COD settlement.",
      image: "/blog/cod-delivery.svg",
      intro: "Cash on Delivery means your customer pays for the parcel when it is delivered. It is useful for online sellers, but the process needs clear parcel records and COD tracking.",
      sections: [
        ["How COD delivery works", ["The parcel is registered for delivery.", "The customer is called before delivery when required.", "The delivery outcome is recorded.", "Collected COD is settled according to the applicable payment process."]],
        ["Why COD records matter", ["A clear parcel record helps you track which orders are delivered.", "Delivery attempts should be recorded so sellers know what happened.", "COD amounts should be matched with parcel status and settlement."]],
        ["Before sending a COD parcel", ["Confirm the customer address and phone number.", "Share the parcel weight and COD amount with the courier.", "Keep the order and parcel reference available for follow-up."]],
      ],
    },
    {
      slug: "wrong-address-delivery",
      category: "Delivery",
      title: "How to reduce failed deliveries from wrong addresses",
      description: "Practical address and customer-confirmation steps to reduce avoidable delivery attempts.",
      image: "/blog/address-delivery.svg",
      intro: "A wrong or unclear address can delay a parcel and add another delivery attempt. Confirming the details before dispatch can help.",
      sections: [
        ["Check the address before pickup", ["Ask for a nearby landmark.", "Confirm the street, block or area name.", "Check the phone number with the customer.", "Record the final address in one clear format."]],
        ["Call before dispatch", ["Confirm that the customer is available.", "Ask the customer to repeat important location details.", "Record changes before the parcel leaves for delivery."]],
        ["Record failed attempts", ["Write down the reason for each failed attempt.", "Keep the customer response with the parcel record.", "Plan the next attempt clearly instead of guessing."]],
      ],
    },
    {
      slug: "prepare-parcels-for-pickup",
      category: "Seller Guide",
      title: "How to prepare parcels for courier pickup",
      description: "A practical checklist for labels, packing and pickup information.",
      image: "/blog/parcel-pickup.svg",
      intro: "Good parcel preparation helps a pickup move smoothly. It also makes handover and tracking easier for the seller.",
      sections: [
        ["Pack the parcel securely", ["Use the right-size box or packaging.", "Protect fragile items with suitable padding.", "Seal the package properly so it does not open during movement."]],
        ["Label every parcel clearly", ["Add the customer name and complete address.", "Add the phone number and order reference.", "Use a readable label that stays attached during delivery."]],
        ["Prepare for pickup", ["Keep all parcels together.", "Arrange labels and COD details before the rider arrives.", "Check parcel count and handover records at pickup."]],
      ],
    },
    {
      slug: "cod-payout-within-24-hours",
      category: "COD",
      title: "Understanding COD payout after delivery",
      description: "Learn what COD payout means and which records sellers should keep.",
      image: "/blog/cod-payout.svg",
      intro: "COD payout is the payment of collected cash against successfully delivered parcels. A clear parcel record makes it easier to match deliveries with settlement.",
      sections: [
        ["Use one reference per parcel", ["Keep the order reference with the parcel.", "Use the parcel ID when checking status.", "Avoid relying only on chat or memory."]],
        ["Match delivery with COD", ["Confirm whether the parcel was delivered.", "Record the collected COD amount.", "Keep settlement details linked to the delivered parcel."]],
        ["Keep follow-up information ready", ["Keep customer and delivery details available.", "Record the payout date and amount.", "Ask for clarification if a settlement does not match the parcel list."]],
      ],
    },
    {
      slug: "free-pickup-for-sellers",
      category: "Karachi",
      title: "When does free pickup apply?",
      description: "Understand the free-pickup rule for sellers sending parcels in Karachi.",
      image: "/blog/free-pickup.svg",
      intro: "Free pickup is available in Karachi when you have 3 or more parcels ready for collection. Preparing the parcels before pickup keeps the handover quick.",
      sections: [
        ["Meet the pickup condition", ["Free pickup applies when 3 or more parcels are ready.", "Confirm the pickup location before the rider arrives.", "Keep the total parcel count accurate."]],
        ["Prepare a complete pickup list", ["Label every parcel.", "Keep COD details with the related orders.", "Arrange parcels together for a faster handover."]],
        ["Confirm pickup details", ["Check the rider handover.", "Keep the parcel references after pickup.", "Track status from the parcel record."]],
      ],
    },
    {
      slug: "outsourced-courier-partners",
      category: "Shipping",
      title: "Shipping outside Karachi through partner couriers",
      description: "What sellers should confirm before sending a parcel outside Karachi.",
      image: "/blog/partner-courier.svg",
      intro: "Shipments outside Karachi can be arranged through partner couriers. Route, weight and parcel details should be confirmed before booking.",
      sections: [
        ["Confirm the destination", ["Check the complete city and address.", "Confirm whether the destination is covered.", "Ask for the applicable route and quote before dispatch."]],
        ["Prepare the parcel details", ["Share the weight and packaging details.", "Include the customer phone number.", "Keep COD details separate and clear if the parcel is COD."]],
        ["Ask before booking", ["Confirm the expected route and timeline.", "Ask which tracking status is available.", "Keep the courier reference for follow-up."]],
      ],
    },
  ];

  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const related = posts.filter((item) => item.slug !== post.slug).slice(0, 3);
---
<BaseLayout title={`${post.title} | Deliverio Express`} description={post.description} canonical={`/blog/${post.slug}/`} ogImage={post.image}>
  <article class="blog-post">
    <header class="blog-post-hero">
      <div class="container blog-post-inner">
        <a class="blog-back-link" href="/blog/">← All articles</a>
        <p class="blog-eyebrow">{post.category}</p>
        <h1>{post.title}</h1>
        <p>{post.intro}</p>
        <img class="blog-post-illustration" src={post.image} alt="" />
      </div>
    </header>

    <div class="container blog-post-layout">
      <div class="blog-post-content">
        {post.sections.map(([heading, bullets], index) => (
          <section>
            <span class="blog-section-index">0{index + 1}</span>
            <h2>{heading}</h2>
            <ul>{bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </section>
        ))}
      </div>
      <aside class="blog-post-sidebar">
        <div class="blog-sidebar-card">
          <p class="blog-eyebrow">NEED HELP?</p>
          <h2>Ask about your shipment.</h2>
          <p>Share your route, parcel weight or pickup question with our team.</p>
          <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>

    <section class="blog-related">
      <div class="container">
        <p class="blog-eyebrow">CONTINUE READING</p>
        <h2>Related articles</h2>
        <div class="blog-related-grid">
          {related.map((item) => (
            <a href={`/blog/${item.slug}/`}>
              <span>{item.category}</span>
              <h3>{item.title}</h3>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .blog-post-hero{padding:58px 0 64px;border-bottom:1px solid rgba(20,217,181,.13);background:radial-gradient(ellipse at 82% 35%,rgba(20,217,181,.1),transparent 40%),#0c2a22}
  .blog-post-inner{width:min(1120px,calc(100% - 44px));margin-inline:auto}.blog-back-link{display:inline-flex;margin-bottom:34px;color:#b7c9c3;font-size:.82rem}.blog-back-link:hover{color:#14d9b5}.blog-eyebrow{margin:0 0 12px;color:#14d9b5;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .blog-post-hero h1{max-width:900px;margin:0;font:700 clamp(2.5rem,5.5vw,4.8rem)/1.04 "Space Grotesk",sans-serif;letter-spacing:-.06em}.blog-post-hero-inner>p:last-child{max-width:720px;margin:20px 0 0;color:#b7c9c3;font-size:1.05rem;line-height:1.7}
  .blog-post-illustration{display:block;width:min(100%,520px);height:auto;margin:32px 0 0;border:1px solid rgba(20,217,181,.16);border-radius:18px}
  .blog-post-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:64px;padding-block:64px}.blog-post-content section{position:relative;padding:0 0 34px 52px;border-bottom:1px solid rgba(210,245,235,.1);margin-bottom:34px}.blog-post-content section:last-child{margin-bottom:0}.blog-section-index{position:absolute;left:0;top:3px;color:#14d9b5;font:700 .82rem "Space Grotesk",sans-serif}.blog-post-content h2{margin:0 0 16px;font:600 clamp(1.55rem,3vw,2.2rem)/1.15 "Space Grotesk",sans-serif}.blog-post-content ul{margin:0;padding:0;list-style:none}.blog-post-content li{position:relative;margin:10px 0;padding-left:20px;color:#bdccc7;font-size:.94rem;line-height:1.7}.blog-post-content li:before{position:absolute;left:0;top:.72em;width:7px;height:7px;border-radius:50%;background:#14d9b5;content:""}
  .blog-sidebar-card{position:sticky;top:24px;padding:24px;border:1px solid rgba(20,217,181,.18);border-radius:18px;background:linear-gradient(145deg,#10231f,#071713)}.blog-sidebar-card h2{margin:0 0 10px;font:600 1.35rem/1.2 "Space Grotesk",sans-serif}.blog-sidebar-card p:not(.blog-eyebrow){margin:0 0 18px;color:#b7c9c3;font-size:.86rem;line-height:1.65}.blog-sidebar-card .button{width:100%;border-radius:10px;background:#14d9b5;color:#06231b}
  .blog-related{padding:62px 0;background:#071713}.blog-related h2{margin:0 0 24px;font:600 clamp(1.8rem,4vw,2.7rem)/1.1 "Space Grotesk",sans-serif}.blog-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.blog-related-grid>a{position:relative;display:block;min-height:180px;padding:22px;border:1px solid rgba(210,245,235,.11);border-radius:16px;text-decoration:none;transition:border-color .2s,transform .2s}.blog-related-grid>a:hover{transform:translateY(-3px);border-color:rgba(20,217,181,.38)}.blog-related-grid>a>span{color:#14d9b5;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.blog-related-grid h3{max-width:260px;margin:18px 0 0;font:600 1.1rem/1.25 "Space Grotesk",sans-serif}.blog-related-grid b{position:absolute;right:18px;bottom:16px;color:#14d9b5}
  @media(max-width:820px){.blog-post-layout{grid-template-columns:1fr;gap:20px}.blog-sidebar-card{position:relative;top:auto}.blog-related-grid{grid-template-columns:1fr}}
  @media(max-width:600px){.blog-post-hero{padding:48px 0 52px}.blog-post-inner{width:calc(100% - 32px)}.blog-back-link{margin-bottom:24px}.blog-post-hero h1{font-size:clamp(2.2rem,11vw,3.2rem)}.blog-post-layout{padding-block:42px}.blog-post-content section{padding-left:38px}.blog-related{padding:48px 0}.blog-related-grid>a{min-height:150px}}
</style>
