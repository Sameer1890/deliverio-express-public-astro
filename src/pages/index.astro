---
import BaseLayout from "../layouts/BaseLayout.astro";
const portal = import.meta.env.PUBLIC_PORTAL_URL || "#";
const tracking = import.meta.env.PUBLIC_TRACKING_URL || "#track";
const heroSlides = [
  {
    kicker: "GOING NATIONWIDE?",
    title: "GO WITH US",
    subtitle: "Trusted courier delivery across Pakistan",
    badge: "DELIVERIO EXPRESS",
    visualTitle: "Pakistan · Nationwide"
  },
  {
    kicker: "SELLING ONLINE?",
    title: "SHIP WITH US",
    subtitle: "Parcel and Cash on Delivery logistics for sellers",
    badge: "ECOMMERCE READY",
    visualTitle: "Store · Customer"
  },
  {
    kicker: "BUSINESS DELIVERY?",
    title: "MOVE WITH US",
    subtitle: "Courier solutions built for growing businesses",
    badge: "BUSINESS LOGISTICS",
    visualTitle: "Pickup · Delivery"
  }
];
---
<BaseLayout
  title="Deliverio Express | Courier & Logistics Services in Karachi, Pakistan"
  description="Deliverio Express helps businesses with parcel delivery, same-day courier services in Karachi, nationwide shipping, cash on delivery (COD) and e-commerce logistics."
  canonical="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Deliverio Express",
      url: Astro.site,
      description: "Courier and logistics services for businesses and individuals in Pakistan."
    })} />
  </Fragment>
  <section class="hero hero-banner" aria-roledescription="carousel">
    <div class="hero-slides">
      {heroSlides.map((slide, index) => (
        <article class:list={["hero-slide", "promo-slide", index === 0 && "is-active"]} data-slide={index} aria-hidden={index !== 0 ? "true" : "false"}>
          <div class="promo-grid">
            <div class="promo-copy">
              <p class="promo-kicker">{slide.kicker}</p>
              <h1>{slide.title}</h1>
              <p class="promo-subtitle">{slide.subtitle}</p>
              <div class="promo-actions">
                <a class="button" href={portal}>Book a Shipment <span aria-hidden="true">↗</span></a>
                <a class="button button-ghost" href={tracking}>Track a Parcel</a>
              </div>
            </div>
            <div class="promo-visual" role="img" aria-label={slide.visualTitle}>
              <div class="promo-cloud cloud-one"></div><div class="promo-cloud cloud-two"></div>
              <div class="route-line route-a"></div><div class="route-line route-b"></div>
              <div class="promo-package">
                <div class="package-tape"></div>
                <div class="package-name">deliverio<span>_express</span></div>
                <div class="package-label"><b>SHIP TO</b><span>YOUR CUSTOMER</span></div>
                <div class="package-arrows">↑ ↑</div>
              </div>
              <div class="promo-landmark">PK</div>
            </div>
          </div>
          <div class="promo-badge">{slide.badge}</div>
        </article>
      ))}
    </div>
    <div class="hero-controls" aria-label="Hero carousel controls">
      <button class="hero-arrow hero-prev" type="button" aria-label="Previous slide">←</button>
      <div class="hero-dots">
        {heroSlides.map((_, index) => <button class:list={["hero-dot", index === 0 && "is-active"]} type="button" data-go={index} aria-label={`Go to slide ${index + 1}`} aria-current={index === 0 ? "true" : undefined}></button>)}
      </div>
      <button class="hero-arrow hero-next" type="button" aria-label="Next slide">→</button>
    </div>
    <div class="container trust-strip">
      <div><b>01</b><span><strong>Parcel delivery</strong><small>For everyday shipments</small></span></div>
      <div><b>02</b><span><strong>E-commerce logistics</strong><small>Built around online sellers</small></span></div>
      <div><b>03</b><span><strong>COD support</strong><small>Subject to service setup</small></span></div>
    </div>
  </section>

  <section class="section track-section" id="track">
    <div class="container track-panel">
      <div><p class="eyebrow">PARCEL VISIBILITY</p><h2>Every shipment has a story.</h2><p>Have a tracking number? Open the tracking portal to check your parcel’s latest available status.</p></div>
      <form class="track-form" id="track-form">
        <label for="tracking-number">Your tracking number</label>
        <div class="track-input-row"><input id="tracking-number" name="tracking" placeholder="e.g. DX123456789" autocomplete="off" required /><button class="button" type="submit">Track parcel <span aria-hidden="true">→</span></button></div>
        <p class="form-hint">Tracking is available when your shipment has been registered in our system.</p>
      </form>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2>Logistics that work for you.</h2><p>Flexible courier services for individuals, growing brands and established businesses.</p></div><a class="text-link" href="/services/">Explore services <span aria-hidden="true">↗</span></a></div>
      <div class="service-grid">
        <article class="service-card"><span class="service-icon">↗</span><h3>Same-day delivery</h3><p>Local delivery options within Karachi, subject to service area and booking time.</p></article>
        <article class="service-card"><span class="service-icon">⌁</span><h3>Nationwide shipping</h3><p>Ship beyond your city through our available logistics partner network.</p></article>
        <article class="service-card"><span class="service-icon">₨</span><h3>Cash on Delivery</h3><p>COD-oriented workflows for eligible e-commerce shipments and sellers.</p></article>
        <article class="service-card"><span class="service-icon">▦</span><h3>E-commerce fulfillment</h3><p>Shipping support for online stores and businesses managing daily orders.</p></article>
        <article class="service-card"><span class="service-icon">□</span><h3>Parcel & documents</h3><p>Delivery options for parcels and important documents.</p></article>
        <article class="service-card"><span class="service-icon">◎</span><h3>Business solutions</h3><p>Talk to us about shipping needs and a workflow that fits your operation.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container split-section">
      <div><p class="eyebrow">MORE THAN DELIVERY</p><h2>Your business moves.<br /><em>We move with it.</em></h2></div>
      <div><p>From the first pickup to the final handover, logistics should feel clear and dependable. Deliverio Express is building practical delivery solutions for Pakistani businesses and their customers.</p><a class="button" href="/about/">Meet Deliverio Express <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-layout">
      <div><p class="eyebrow">NEED TO KNOW</p><h2>Common questions.</h2><p>Need help with a shipment? Contact our team for current coverage, availability and pricing.</p><a class="text-link" href="/contact/">Contact our team ↗</a></div>
      <div class="faq-list">
        <details><summary>Where does Deliverio Express operate?</summary><p>Our launch focus is Karachi. Nationwide shipments may be handled through third-party logistics partners, depending on route availability.</p></details>
        <details><summary>Can I send a parcel with Cash on Delivery?</summary><p>COD availability depends on seller onboarding, shipment eligibility and service setup. Contact us to confirm the current process.</p></details>
        <details><summary>How can I track my shipment?</summary><p>Use the tracking link and enter the tracking number assigned to your registered shipment.</p></details>
        <details><summary>How do I get delivery rates?</summary><p>Contact our team with pickup city, destination, parcel weight and service type so we can confirm the applicable rate.</p></details>
      </div>
    </div>
  </section>
  <script>
    const hero = document.querySelector(".hero");
    const slides = Array.from(document.querySelectorAll(".hero-slide"));
    const dots = Array.from(document.querySelectorAll(".hero-dot"));
    let activeSlide = 0;
    let carouselTimer;

    const showSlide = (nextIndex) => {
      if (!slides.length) return;
      activeSlide = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.classList.toggle("is-active", index === activeSlide);
        slide.setAttribute("aria-hidden", index === activeSlide ? "false" : "true");
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === activeSlide);
        if (index === activeSlide) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const restartCarousel = () => {
      window.clearInterval(carouselTimer);
      carouselTimer = window.setInterval(() => showSlide(activeSlide + 1), 6000);
    };

    document.querySelector(".hero-prev")?.addEventListener("click", () => { showSlide(activeSlide - 1); restartCarousel(); });
    document.querySelector(".hero-next")?.addEventListener("click", () => { showSlide(activeSlide + 1); restartCarousel(); });
    dots.forEach((dot) => dot.addEventListener("click", () => { showSlide(Number(dot.dataset.go)); restartCarousel(); }));
    hero?.addEventListener("mouseenter", () => window.clearInterval(carouselTimer));
    hero?.addEventListener("mouseleave", restartCarousel);
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) restartCarousel();

    const form = document.querySelector("#track-form");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = new FormData(form).get("tracking")?.toString().trim();
      if (!value) return;
      const target = import.meta.env.PUBLIC_TRACKING_URL;
      if (!target) {
        alert("Tracking portal is not connected yet. Please configure PUBLIC_TRACKING_URL.");
        return;
      }
      const url = new URL(target);
      url.searchParams.set("tracking", value);
      window.location.href = url.toString();
    });
  </script>
</BaseLayout>