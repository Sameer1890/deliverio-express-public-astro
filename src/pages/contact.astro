---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact Deliverio Express | Courier Support in Karachi" description="Contact Deliverio Express on WhatsApp or email for courier services, shipment rates, COD and seller onboarding in Karachi." canonical="/contact/">
  <section class="page-hero"><div class="container"><p class="eyebrow">CONTACT</p><h1>Let’s get your parcels<br /><em>moving.</em></h1><p>Contact us about shipping, seller onboarding, rates or service availability.</p></div></section>
  <section class="section"><div class="container contact-grid">
    <div><p class="eyebrow">TALK TO OUR TEAM</p><h2>Tell us what you need to ship.</h2><p>For a useful quote, include your pickup location, destination, approximate parcel weight and expected shipment volume.</p></div>
    <div class="contact-details">
      <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">WhatsApp: 0332-0200789 <span aria-hidden="true">↗</span></a>
      <a class="button button-ghost" href="https://wa.me/923320200789?text=Hi%2C%20I%20want%20to%20register%20as%20a%20seller." target="_blank" rel="noopener noreferrer">Register as a seller <span aria-hidden="true">↗</span></a>
      <a class="contact-email" href="mailto:deliverioexpress@gmail.com">deliverioexpress@gmail.com</a>
      <p class="contact-location">Karachi, Pakistan</p>
    </div>
  </div></section>
</BaseLayout>
