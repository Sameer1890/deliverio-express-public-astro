---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact Deliverio Express | Courier Support in Karachi" description="Contact Deliverio Express to ask about courier services, shipment rates, COD, seller onboarding and delivery coverage in Karachi and supported destinations." canonical="/contact/">
  <section class="page-hero"><div class="container"><p class="eyebrow">CONTACT</p><h1>Let’s get your parcels<br /><em>moving.</em></h1><p>Contact us about shipping, seller onboarding, rates or service availability.</p></div></section>
  <section class="section"><div class="container contact-grid"><div><p class="eyebrow">TALK TO OUR TEAM</p><h2>Tell us what you need to ship.</h2><p>For a useful quote, include your pickup location, destination, approximate parcel weight and expected shipment volume.</p><div class="contact-note"><strong>Operating focus</strong><span>Karachi, Pakistan</span><small>Confirm current service areas and operating hours with our team.</small></div><div class="contact-note"><strong>Email</strong><span>Add your verified business email before launch</span><small>Replace this placeholder with your real contact details.</small></div></div>
  <form class="contact-form" action="#" method="get" onsubmit="return false"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" placeholder="Full name" required /><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required /><label for="topic">How can we help?</label><select id="topic" name="topic"><option>Shipping rates</option><option>Seller onboarding</option><option>Shipment tracking</option><option>Business logistics</option><option>Other question</option></select><label for="message">Message</label><textarea id="message" name="message" rows="4" placeholder="Tell us about your shipment needs" required></textarea><p class="form-hint">This demo form is not connected to email yet. Connect it to your backend or a form service before launch.</p><button class="button" type="submit" disabled>Contact form setup required</button></form></div></section>
</BaseLayout>