---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact Deliverio Express | Courier Support"
  description="Contact Deliverio Express for courier rates, COD delivery, free pickup, seller onboarding and shipments outside Karachi."
  canonical="/contact/"
>
  <div class="contact-page">
    <section class="contact-hero">
      <div class="container">
        <p class="contact-eyebrow">CONTACT US</p>
        <h1>Let’s get your<br /><span>parcels moving.</span></h1>
        <p>Send us your shipment details and our team will respond on WhatsApp.</p>
      </div>
    </section>

    <section class="contact-main">
      <div class="container contact-grid">
        <aside class="contact-info">
          <p class="contact-eyebrow">TALK TO OUR TEAM</p>
          <h2>Delivery questions are welcome.</h2>
          <p>Share pickup location, destination, parcel weight and expected shipment volume for a useful response.</p>

          <div class="contact-methods">
            <a href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20l1.2-5.2A8.4 8.4 0 1 1 21 11.5Z"/><path d="M8.5 9.5c.5 2 2 3.5 4 4"/></svg>
              <span><small>WHATSAPP</small><strong>0332-0200789</strong></span>
              <b aria-hidden="true">↗</b>
            </a>
            <a href="mailto:deliverioexpress@gmail.com">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
              <span><small>EMAIL</small><strong>deliverioexpress@gmail.com</strong></span>
              <b aria-hidden="true">↗</b>
            </a>
            <div class="contact-location">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span><small>LOCATION</small><strong>Karachi, Pakistan</strong></span>
            </div>
          </div>
        </aside>

        <form class="contact-form" id="contact-form">
          <div class="contact-form-heading">
            <p class="contact-eyebrow">SEND A MESSAGE</p>
            <h2>Tell us what you need.</h2>
          </div>
          <div class="contact-fields">
            <label for="contact-name">Your name
              <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Full name" required />
            </label>
            <label for="contact-phone">Phone number
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="03xx-xxxxxxx" required />
            </label>
            <label for="contact-topic">How can we help?
              <select id="contact-topic" name="topic" required>
                <option value="" disabled selected>Select an option</option>
                <option>Shipping rates</option>
                <option>Seller registration</option>
                <option>Shipment pickup</option>
                <option>COD delivery</option>
                <option>Shipment outside Karachi</option>
                <option>Other question</option>
              </select>
            </label>
          </div>
          <label for="contact-message">Message
            <textarea id="contact-message" name="message" rows="5" placeholder="Pickup location, destination, parcel weight and shipment volume" required></textarea>
          </label>
          <button class="button contact-submit" type="submit">Send via WhatsApp <span aria-hidden="true">↗</span></button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!contactForm.reportValidity()) return;

    const data = new FormData(contactForm);
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const topic = String(data.get("topic") || "").trim();
    const message = String(data.get("message") || "").trim();

    const text = [
      "Hi Deliverio Express,",
      "",
      `Name: ${name}`,
      `Phone: ${phone}`,
      `Topic: ${topic}`,
      "",
      `Message: ${message}`,
    ].filter(Boolean).join("\n");

    window.open(`https://wa.me/923320200789?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
  });
</script>

<style>
  .contact-page {
    --contact-bg: #061311;
    --contact-panel: #0c2a22;
    --contact-mint: #14d9b5;
    --contact-white: #f5fbf9;
    --contact-muted: #b7c9c3;
    background: var(--contact-bg);
    color: var(--contact-white);
  }

  .contact-page svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--contact-mint);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-page .container {
    width: min(1120px, calc(100% - 44px));
    margin-inline: auto;
  }

  .contact-hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 62px;
    border-bottom: 1px solid rgba(20, 217, 181, 0.13);
    background: radial-gradient(ellipse at 86% 34%, rgba(20, 217, 181, 0.1), transparent 38%), #0c2a22;
  }

  .contact-hero:after {
    position: absolute;
    right: 8%;
    bottom: -150px;
    width: 320px;
    height: 320px;
    border: 1px solid rgba(20, 217, 181, 0.1);
    border-radius: 50%;
    box-shadow: 0 0 0 38px rgba(20, 217, 181, 0.025), 0 0 0 76px rgba(20, 217, 181, 0.018);
    content: "";
  }

  .contact-hero .container {
    position: relative;
    z-index: 1;
  }

  .contact-eyebrow {
    margin: 0 0 12px;
    color: var(--contact-mint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .contact-hero h1 {
    margin: 0;
    font: 700 clamp(2.8rem, 6vw, 5rem)/1.02 "Space Grotesk", sans-serif;
    letter-spacing: -0.065em;
  }

  .contact-hero h1 span {
    color: var(--contact-mint);
  }

  .contact-hero .container>p:last-child {
    max-width: 590px;
    margin: 18px 0 0;
    color: var(--contact-muted);
    font-size: 1.05rem;
  }

  .contact-main {
    padding: 64px 0 76px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 28px;
    align-items: start;
  }

  .contact-info {
    padding: 28px 28px 28px 0;
  }

  .contact-info h2,
  .contact-form h2 {
    margin: 0 0 14px;
    font: 600 clamp(1.8rem, 4vw, 2.7rem)/1.1 "Space Grotesk", sans-serif;
    letter-spacing: -0.05em;
  }

  .contact-info>p:not(.contact-eyebrow) {
    max-width: 430px;
    margin: 0;
    color: var(--contact-muted);
    line-height: 1.75;
  }

  .contact-methods {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  .contact-methods>a,
  .contact-location {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 74px;
    padding: 12px 14px;
    border: 1px solid rgba(20, 217, 181, 0.14);
    border-radius: 14px;
    background: rgba(12, 42, 34, 0.55);
  }

  .contact-methods>a {
    text-decoration: none;
  }

  .contact-methods>a:hover {
    border-color: rgba(20, 217, 181, 0.38);
  }

  .contact-methods span {
    display: grid;
    min-width: 0;
  }

  .contact-methods small {
    color: var(--contact-mint);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .contact-methods strong {
    overflow-wrap: anywhere;
    font-size: 0.88rem;
  }

  .contact-methods b {
    color: var(--contact-mint);
  }

  .contact-form {
    padding: 30px;
    border: 1px solid rgba(20, 217, 181, 0.18);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(12, 42, 34, 0.92), rgba(7, 22, 18, 0.96));
  }

  .contact-form-heading {
    margin-bottom: 22px;
  }

  .contact-form-heading h2 {
    margin-bottom: 0;
  }

  .contact-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-form label {
    display: grid;
    gap: 7px;
    color: #dceae6;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .contact-form label[for="contact-message"] {
    margin-top: 14px;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(210, 245, 235, 0.11);
    border-radius: 10px;
    background: #071713;
    color: var(--contact-white);
    outline: none;
  }

  .contact-form input,
  .contact-form select {
    height: 48px;
    padding: 0 13px;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
    padding: 12px 13px;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: rgba(20, 217, 181, 0.62);
    box-shadow: 0 0 0 3px rgba(20, 217, 181, 0.07);
  }

  .contact-submit {
    width: 100%;
    min-height: 52px;
    margin-top: 16px;
    border: 0;
    border-radius: 11px;
    background: var(--contact-mint);
    color: #06231b;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .contact-info {
      padding: 0;
    }
  }

  @media (max-width: 600px) {
    .contact-page .container {
      width: calc(100% - 32px);
    }

    .contact-hero {
      padding-block: 58px 48px;
    }

    .contact-hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.6rem);
    }

    .contact-main {
      padding-block: 42px 56px;
    }

    .contact-fields {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 22px 16px;
    }

    .contact-methods>a,
    .contact-location {
      grid-template-columns: 38px 1fr auto;
      padding-inline: 12px;
    }
  }
</style>
