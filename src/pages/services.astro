---
import BaseLayout from "../layouts/BaseLayout.astro";
const services = [
  ["Karachi COD delivery", "Cash on Delivery courier service for online orders within Karachi."],
  ["Free pickup", "Free parcel pickup in Karachi when you have 3 or more parcels."],
  ["COD payout in 24 hours", "Receive COD payout within 24 hours after delivery in Karachi."],
  ["Outside Karachi via partner couriers", "Ship to destinations outside Karachi through partner couriers."]
];
---
<BaseLayout title="Courier Services in Karachi | Deliverio Express" description="Explore Deliverio Express Karachi COD delivery, free pickup, COD payouts within 24 hours and partner courier services outside Karachi." canonical="/services/">
  <section class="page-hero"><div class="container"><p class="eyebrow">OUR SERVICES</p><h1>Shipping built around<br /><em>your business.</em></h1><p>Courier services for Karachi sellers, with partner courier shipping outside the city.</p></div></section>
  <section class="section"><div class="container service-grid service-grid-large">{services.map(([title, description], index) => <article class="service-card"><span class="service-number">0{index + 1}</span><h2>{title}</h2><p>{description}</p></article>)}</div></section>
  <section class="section dark-section"><div class="container split-section"><div><p class="eyebrow">LET’S TALK LOGISTICS</p><h2>Need a shipping partner?</h2></div><div><p>Share your shipment volume, routes and service requirements with our team.</p><a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">Contact us on WhatsApp <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
