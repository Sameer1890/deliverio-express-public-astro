---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Courier Services in Karachi | Deliverio Express"
  description="Explore Deliverio Express COD delivery, free pickup, 24-hour COD payout and partner courier shipping outside Karachi."
  canonical="/services/"
>
  <div class="services-page">
    <section class="services-hero">
      <div class="container services-hero-inner">
        <p class="services-eyebrow">OUR SERVICES</p>
        <h1>Courier support built<br /><span>around your orders.</span></h1>
        <p>Clear parcel handling, COD delivery, free pickup and recorded delivery updates for sellers.</p>
        <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">Talk to us on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="services-overview container" aria-label="Core services">
      <article class="service-feature-card">
        <div class="service-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-12 5h3"/></svg>
        </div>
        <p class="services-kicker">01 / COD DELIVERY</p>
        <h2>Karachi COD delivery</h2>
        <p>Cash on Delivery courier service for online orders within Karachi.</p>
        <a href="/pricing/">View Karachi pricing <span aria-hidden="true">→</span></a>
      </article>

      <article class="service-feature-card">
        <div class="service-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h12v11H3zM15 11h4l3 3v4h-7z"/><circle cx="7.5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/></svg>
        </div>
        <p class="services-kicker">02 / PICKUP</p>
        <h2>Free pickup</h2>
        <p>Free parcel pickup in Karachi when you have 3 or more parcels ready.</p>
        <a href="https://wa.me/923320200789?text=Hi%2C%20I%20want%20to%20book%20a%20pickup." target="_blank" rel="noopener noreferrer">Book a pickup <span aria-hidden="true">→</span></a>
      </article>

      <article class="service-feature-card">
        <div class="service-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/><path d="M8 3l1 3m7-3-1 3"/></svg>
        </div>
        <p class="services-kicker">03 / COD SETTLEMENT</p>
        <h2>COD payout in 24 hours</h2>
        <p>COD is paid within 24 hours after delivery.</p>
        <a href="/about/">See how COD works <span aria-hidden="true">→</span></a>
      </article>

      <article class="service-feature-card">
        <div class="service-feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="18" r="2"/><circle cx="19" cy="6" r="2"/><path d="M7 18h4a3 3 0 0 0 3-3V9a3 3 0 0 1 3-3"/><path d="m15 4 2 2-2 2"/></svg>
        </div>
        <p class="services-kicker">04 / PARTNER SHIPPING</p>
        <h2>Outside Karachi</h2>
        <p>Ship to destinations outside Karachi through partner couriers.</p>
        <a href="https://wa.me/923320200789?text=Hi%2C%20I%20need%20a%20quote%20for%20a%20shipment%20outside%20Karachi." target="_blank" rel="noopener noreferrer">Request a quote <span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="services-workflow">
      <div class="container">
        <div class="services-section-heading">
          <p class="services-eyebrow">HOW A SHIPMENT MOVES</p>
          <h2>One clear process from pickup to settlement</h2>
        </div>
        <div class="services-steps">
          <article><span>01</span><div><h3>Share your parcel details</h3><p>Route, parcel weight and customer details are confirmed.</p></div></article>
          <article><span>02</span><div><h3>Parcel is recorded</h3><p>The shipment is registered in our system.</p></div></article>
          <article><span>03</span><div><h3>Customer is called</h3><p>Address and availability are confirmed before delivery.</p></div></article>
          <article><span>04</span><div><h3>COD is settled</h3><p>The delivery outcome is recorded and COD is paid within 24 hours.</p></div></article>
        </div>
      </div>
    </section>

    <section class="services-details">
      <div class="container services-details-grid">
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <p class="services-kicker">DELIVERY TIME</p>
          <h2>Confirm timing before booking</h2>
          <p>Delivery time depends on the destination and route. Contact us for the current timeline for your shipment.</p>
        </article>
        <article>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-12 5h3"/></svg>
          <p class="services-kicker">COD HANDLING</p>
          <h2>Every COD parcel recorded</h2>
          <p>Collected COD is matched with parcel delivery and paid within 24 hours after delivery.</p>
        </article>
      </div>
    </section>

    <section class="services-cta">
      <div class="container">
        <div class="services-cta-inner">
          <div>
            <p class="services-eyebrow">READY TO START?</p>
            <h2>Let’s move your parcels.</h2>
            <p>Share your pickup location, route and parcel details with our team.</p>
          </div>
          <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">Contact us on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .services-page {
    --services-bg: #061311;
    --services-panel: #0c2a22;
    --services-mint: #14d9b5;
    --services-white: #f5fbf9;
    --services-muted: #b7c9c3;
    background: var(--services-bg);
    color: var(--services-white);
  }

  .services-page svg {
    width: 29px;
    height: 29px;
    fill: none;
    stroke: var(--services-mint);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .services-page .container {
    width: min(1120px, calc(100% - 44px));
    margin-inline: auto;
  }

  .services-hero {
    position: relative;
    overflow: hidden;
    padding: 78px 0 68px;
    border-bottom: 1px solid rgba(20, 217, 181, 0.13);
    background: radial-gradient(ellipse at 84% 35%, rgba(20, 217, 181, 0.11), transparent 38%), #0c2a22;
  }

  .services-hero:after {
    position: absolute;
    right: 8%;
    bottom: -170px;
    width: 360px;
    height: 360px;
    border: 1px solid rgba(20, 217, 181, 0.1);
    border-radius: 50%;
    box-shadow: 0 0 0 42px rgba(20, 217, 181, 0.025), 0 0 0 84px rgba(20, 217, 181, 0.018);
    content: "";
  }

  .services-hero-inner {
    position: relative;
    z-index: 1;
  }

  .services-eyebrow,
  .services-kicker {
    margin: 0 0 13px;
    color: var(--services-mint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .services-hero h1 {
    max-width: 820px;
    margin: 0;
    font: 700 clamp(2.8rem, 6vw, 5.1rem)/1.02 "Space Grotesk", sans-serif;
    letter-spacing: -0.065em;
  }

  .services-hero h1 span {
    color: var(--services-mint);
  }

  .services-hero-inner>p:last-of-type {
    max-width: 620px;
    margin: 20px 0 24px;
    color: var(--services-muted);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.7;
  }

  .services-hero .button,
  .services-cta .button {
    border-radius: 11px;
    background: var(--services-mint);
    border-color: var(--services-mint);
    color: #06231b;
  }

  .services-overview {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
    padding-block: 34px 74px;
  }

  .service-feature-card {
    display: grid;
    min-height: 300px;
    align-content: start;
    padding: 24px 21px;
    border: 1px solid rgba(20, 217, 181, 0.16);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(16, 35, 31, 0.92), rgba(7, 22, 18, 0.92));
    transition: transform 0.2s, border-color 0.2s;
  }

  .service-feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(20, 217, 181, 0.38);
  }

  .service-feature-icon {
    display: grid;
    width: 52px;
    height: 52px;
    margin-bottom: 28px;
    place-items: center;
    border: 1px solid rgba(20, 217, 181, 0.24);
    border-radius: 15px;
    background: rgba(20, 217, 181, 0.07);
  }

  .service-feature-card h2,
  .services-details h2,
  .services-section-heading h2,
  .services-cta h2 {
    margin: 0 0 12px;
    font: 600 clamp(1.35rem, 2.2vw, 1.75rem)/1.12 "Space Grotesk", sans-serif;
    letter-spacing: -0.04em;
  }

  .service-feature-card>p:not(.services-kicker) {
    min-height: 74px;
    margin: 0;
    color: var(--services-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .service-feature-card>a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    color: var(--services-mint);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .services-workflow {
    padding: 72px 0;
    border-block: 1px solid rgba(20, 217, 181, 0.12);
    background: rgba(2, 17, 13, 0.28);
  }

  .services-section-heading {
    max-width: 680px;
    margin-bottom: 34px;
  }

  .services-section-heading h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .services-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .services-steps article {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    min-height: 150px;
    padding: 0 20px;
    border-left: 1px solid rgba(20, 217, 181, 0.2);
  }

  .services-steps article:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .services-steps article>span {
    color: var(--services-mint);
    font: 700 0.9rem "Space Grotesk", sans-serif;
  }

  .services-steps h3 {
    margin: 0 0 8px;
    font: 600 1rem "Space Grotesk", sans-serif;
  }

  .services-steps p,
  .services-details article>p:last-child {
    margin: 0;
    color: var(--services-muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .services-details {
    padding: 60px 0;
  }

  .services-details-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .services-details article {
    padding: 28px;
    border: 1px solid rgba(20, 217, 181, 0.16);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(16, 35, 31, 0.72), rgba(7, 22, 18, 0.72));
  }

  .services-details .services-kicker {
    margin-top: 20px;
  }

  .services-details h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .services-cta {
    padding: 0 0 74px;
  }

  .services-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 38px 42px;
    border: 1px solid rgba(20, 217, 181, 0.22);
    border-radius: 22px;
    background: radial-gradient(ellipse at 75% 50%, rgba(20, 217, 181, 0.12), transparent 52%), #0a1d18;
  }

  .services-cta h2 {
    margin-bottom: 8px;
  }

  .services-cta-inner>div>p:last-child {
    margin: 0;
    color: var(--services-muted);
  }

  .services-cta .button {
    flex: none;
  }

  @media (max-width: 900px) {
    .services-overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 0;
    }

    .services-steps article:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 600px) {
    .services-page .container {
      width: calc(100% - 32px);
    }

    .services-hero {
      padding-block: 58px 48px;
    }

    .services-hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.6rem);
    }

    .services-overview {
      grid-template-columns: 1fr;
      gap: 10px;
      padding-block: 18px 50px;
    }

    .service-feature-card {
      min-height: 0;
      padding: 20px;
    }

    .service-feature-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 20px;
    }

    .service-feature-card>p:not(.services-kicker) {
      min-height: 0;
      margin-bottom: 18px;
    }

    .services-workflow {
      padding-block: 50px;
    }

    .services-section-heading h2 {
      font-size: 2rem;
    }

    .services-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 0;
    }

    .services-steps article {
      min-height: 0;
      padding: 0 12px;
    }

    .services-steps article:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .services-details-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .services-details article {
      padding: 22px 20px;
    }

    .services-cta-inner {
      align-items: flex-start;
      flex-direction: column;
      padding: 28px 20px;
    }

    .services-cta .button {
      width: 100%;
    }
  }
</style>
