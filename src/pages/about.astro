---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About Deliverio Express | Clear Parcel Delivery"
  description="Learn about Deliverio Express, our parcel records, delivery-attempt tracking, COD process and delivery coverage."
  canonical="/about/"
>
  <div class="about-page">
    <section class="about-hero">
      <div class="container about-hero-inner">
        <p class="about-eyebrow">ABOUT DELIVERIO EXPRESS</p>
        <h1>A clearer way to move<br /><span>every parcel.</span></h1>
        <p>We record every parcel, delivery attempt and COD payment—so sellers can see what happened at each step.</p>
      </div>
    </section>

    <section class="about-facts container" aria-label="Delivery facts">
      <article class="about-fact">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <strong>24 hours</strong><span>COD payout after delivery</span>
      </article>
      <article class="about-fact">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v13H3zM3 11h18M7 15h4"/><path d="M7 4h10"/></svg>
        <strong>Rs. 150</strong><span>Delivery up to 1 kg in Karachi</span>
      </article>
      <article class="about-fact">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h12v11H3zM15 11h4l3 3v4h-7z"/><circle cx="7.5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/></svg>
        <strong>Free pickup</strong><span>With 3 or more parcels</span>
      </article>
      <article class="about-fact">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM4 11h16M8 15h3"/><path d="M8 4h8"/></svg>
        <strong>Every parcel</strong><span>Recorded in our system</span>
      </article>
    </section>

    <section class="about-section about-problems-section">
      <div class="container">
        <div class="about-section-heading">
          <p class="about-eyebrow">BUILT AROUND REAL DELIVERY CHALLENGES</p>
          <h2>The problems sellers face</h2>
        </div>
        <div class="about-problem-list">
          <article class="about-problem-row">
            <div class="about-problem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/></svg><div><span>THE PROBLEM</span><h3>Wrong or unclear addresses</h3></div></div>
            <div class="about-answer"><span>OUR ANSWER</span><p>We call the customer before delivery and record the outcome of each attempt.</p></div>
          </article>
          <article class="about-problem-row">
            <div class="about-problem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13H9l-5 4z"/><path d="m9 9 6 6m0-6-6 6"/></svg><div><span>THE PROBLEM</span><h3>Customers who don’t answer</h3></div></div>
            <div class="about-answer"><span>OUR ANSWER</span><p>We call before delivery and keep a record of every delivery attempt.</p></div>
          </article>
          <article class="about-problem-row">
            <div class="about-problem"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-12 5h3"/></svg><div><span>THE PROBLEM</span><h3>COD that arrives late</h3></div></div>
            <div class="about-answer"><span>OUR ANSWER</span><p>We record COD for each parcel and pay it within 24 hours of delivery.</p></div>
          </article>
          <article class="about-problem-row">
            <div class="about-problem"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8m-8 4h5"/><circle cx="17" cy="17" r="3"/></svg><div><span>THE PROBLEM</span><h3>Unclear parcel status</h3></div></div>
            <div class="about-answer"><span>OUR ANSWER</span><p>Our system records each parcel, delivery attempt and COD amount.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section container about-story">
      <div class="about-story-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M3 7h12v11H3zM15 11h4l3 3v4h-7z"/><circle cx="7.5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/></svg>
      </div>
      <div>
        <p class="about-eyebrow">OUR STORY</p>
        <h2>Delivery, understood from the ground up.</h2>
        <p>Deliverio Express grew from hands-on work in the delivery industry and running local courier deliveries. We saw how wrong addresses, missed calls and delayed COD can affect a seller’s day.</p>
        <p>We brought delivery operations and software together to keep a clear record of every parcel, every attempt and every rupee of COD—without relying on notebooks and memory.</p>
      </div>
    </section>

    <section class="about-section about-values-section">
      <div class="container">
        <div class="about-section-heading">
          <p class="about-eyebrow">WHAT GUIDES OUR WORK</p>
          <h2>Mission, vision &amp; values</h2>
        </div>
        <div class="about-values-grid">
          <article class="about-info-card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h16"/><path d="m7 15 4-4 3 2 5-6"/><path d="M15 7h4v4"/></svg>
            <h3>Our mission</h3>
            <p>Make delivery clearer by keeping accurate records of parcels, delivery attempts and COD.</p>
          </article>
          <article class="about-info-card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
            <h3>Our vision</h3>
            <p>Give sellers a clear view of what happened to each parcel and what COD is due.</p>
          </article>
          <article class="about-info-card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
            <h3>Our values</h3>
            <p>Clear records, thoughtful communication and accountability at every attempt.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section container about-process-section">
      <div class="about-section-heading">
        <p class="about-eyebrow">HOW IT WORKS</p>
        <h2>Four steps, a clear record</h2>
      </div>
      <div class="about-steps">
        <article><span>01</span><h3>Share the order</h3><p>Send the parcel and customer details.</p></article>
        <article><span>02</span><h3>We record it</h3><p>The parcel details are entered in our system.</p></article>
        <article><span>03</span><h3>We call the customer</h3><p>We call before delivery and record each attempt.</p></article>
        <article><span>04</span><h3>Delivery &amp; COD</h3><p>We record the result and pay COD within 24 hours of delivery.</p></article>
      </div>
    </section>

    <section class="about-section about-delivery-section">
      <div class="container about-delivery-grid">
        <article class="about-detail-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <p class="about-eyebrow">DELIVERY TIME</p>
          <h2>Know the expected timing.</h2>
          <p>Delivery time depends on the destination and route. Contact us before booking to confirm the expected timeline.</p>
        </article>
        <article class="about-detail-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-12 5h3"/></svg>
          <p class="about-eyebrow">COD PAYMENT</p>
          <h2>COD paid within 24 hours.</h2>
          <p>We record COD for each parcel and pay it within 24 hours of delivery.</p>
        </article>
      </div>
    </section>

    <section class="about-section about-coverage-section">
      <div class="container about-coverage">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <div>
          <p class="about-eyebrow">WHERE WE DELIVER</p>
          <h2>Karachi and beyond.</h2>
          <p>Local delivery is available in Karachi. For destinations outside Karachi, we arrange delivery through partner couriers.</p>
        </div>
      </div>
    </section>

    <section class="about-section container">
      <div class="about-cta">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20l1.2-5.2A8.4 8.4 0 1 1 21 11.5Z"/><path d="M8.5 9.5c.5 2 2 3.5 4 4"/></svg>
        <p class="about-eyebrow">GET STARTED</p>
        <h2>Let’s talk about your deliveries.</h2>
        <p>Message our team to discuss routes, rates and seller setup.</p>
        <a class="button" href="https://wa.me/923320200789" target="_blank" rel="noopener noreferrer">Chat with us on WhatsApp <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    --about-bg: #0c2a22;
    --about-mint: #14d9b5;
    --about-white: #f5fbf9;
    --about-muted: #b7c9c3;
    background: var(--about-bg);
    color: var(--about-white);
  }

  .about-page svg {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: var(--about-mint);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .about-page .container {
    width: min(1120px, calc(100% - 44px));
    margin-inline: auto;
  }

  .about-hero {
    position: relative;
    overflow: hidden;
    padding: 82px 0 74px;
    border-bottom: 1px solid rgba(20, 217, 181, 0.14);
    background: radial-gradient(ellipse at 86% 34%, rgba(20, 217, 181, 0.1), transparent 38%), #0c2a22;
  }

  .about-hero:after {
    position: absolute;
    right: 7%;
    bottom: -180px;
    width: 390px;
    height: 390px;
    border: 1px solid rgba(20, 217, 181, 0.1);
    border-radius: 50%;
    box-shadow: 0 0 0 42px rgba(20, 217, 181, 0.025), 0 0 0 84px rgba(20, 217, 181, 0.02);
    content: "";
    pointer-events: none;
  }

  .about-hero-inner {
    position: relative;
    z-index: 1;
  }

  .about-eyebrow {
    margin: 0 0 13px;
    color: var(--about-mint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .about-hero h1 {
    max-width: 850px;
    margin: 0;
    font: 700 clamp(2.8rem, 6vw, 5.2rem)/1.02 "Space Grotesk", sans-serif;
    letter-spacing: -0.065em;
  }

  .about-hero h1 span {
    color: var(--about-mint);
  }

  .about-hero-inner>p:last-child {
    max-width: 650px;
    margin: 22px 0 0;
    color: var(--about-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    padding-block: 22px;
  }

  .about-fact {
    display: grid;
    justify-items: start;
    gap: 7px;
    min-height: 130px;
    padding: 18px;
    border: 1px solid rgba(20, 217, 181, 0.17);
    border-radius: 15px;
    background: rgba(3, 19, 15, 0.28);
  }

  .about-fact strong {
    font: 700 1.15rem "Space Grotesk", sans-serif;
  }

  .about-fact span {
    color: var(--about-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .about-section {
    padding-block: 72px;
  }

  .about-section-heading {
    margin-bottom: 28px;
  }

  .about-section-heading h2,
  .about-story h2,
  .about-detail-card h2,
  .about-coverage h2,
  .about-cta h2 {
    margin: 0;
    font: 600 clamp(1.8rem, 3.5vw, 2.7rem)/1.12 "Space Grotesk", sans-serif;
    letter-spacing: -0.05em;
  }

  .about-problems-section,
  .about-values-section,
  .about-delivery-section,
  .about-coverage-section {
    border-block: 1px solid rgba(20, 217, 181, 0.12);
    background: rgba(2, 17, 13, 0.22);
  }

  .about-problem-list {
    display: grid;
    gap: 10px;
  }

  .about-problem-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border: 1px solid rgba(20, 217, 181, 0.15);
    border-radius: 15px;
    background: rgba(3, 19, 15, 0.3);
  }

  .about-problem,
  .about-answer {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    padding: 18px 22px;
  }

  .about-problem {
    border-right: 1px solid rgba(20, 217, 181, 0.14);
  }

  .about-problem>div {
    display: grid;
    gap: 4px;
  }

  .about-problem span,
  .about-answer>span {
    color: var(--about-mint);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }

  .about-problem h3 {
    margin: 0;
    font: 600 0.98rem "Space Grotesk", sans-serif;
  }

  .about-answer {
    display: grid;
    align-content: center;
    gap: 5px;
  }

  .about-answer p {
    margin: 0;
    color: var(--about-muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .about-story {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .about-story-mark,
  .about-coverage>svg {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid rgba(20, 217, 181, 0.25);
    border-radius: 17px;
    background: rgba(20, 217, 181, 0.07);
  }

  .about-story h2 {
    max-width: 700px;
    margin-bottom: 17px;
  }

  .about-story p:not(.about-eyebrow) {
    max-width: 780px;
    margin: 0 0 13px;
    color: var(--about-muted);
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .about-values-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .about-info-card,
  .about-detail-card {
    padding: 24px;
    border: 1px solid rgba(20, 217, 181, 0.16);
    border-radius: 17px;
    background: linear-gradient(145deg, rgba(20, 57, 47, 0.62), rgba(4, 25, 19, 0.48));
  }

  .about-info-card h3 {
    margin: 19px 0 9px;
    font: 600 1.1rem "Space Grotesk", sans-serif;
  }

  .about-info-card p,
  .about-detail-card>p:last-child {
    margin: 0;
    color: var(--about-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .about-process-section .about-section-heading {
    margin-bottom: 30px;
  }

  .about-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  .about-steps article {
    padding: 0 22px;
    border-left: 1px solid rgba(20, 217, 181, 0.2);
  }

  .about-steps article:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .about-steps article>span {
    color: var(--about-mint);
    font: 700 1.15rem "Space Grotesk", sans-serif;
  }

  .about-steps h3 {
    margin: 12px 0 9px;
    font: 600 0.98rem "Space Grotesk", sans-serif;
  }

  .about-steps p {
    margin: 0;
    color: var(--about-muted);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .about-delivery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .about-detail-card .about-eyebrow {
    margin-top: 20px;
  }

  .about-detail-card h2 {
    margin-bottom: 12px;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
  }

  .about-coverage {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 22px;
    align-items: start;
  }

  .about-coverage h2 {
    margin-bottom: 10px;
  }

  .about-coverage p:last-child {
    max-width: 740px;
    margin: 0;
    color: var(--about-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .about-cta {
    display: grid;
    justify-items: center;
    padding: 46px 24px;
    border: 1px solid rgba(20, 217, 181, 0.22);
    border-radius: 24px;
    background: radial-gradient(ellipse at top, rgba(20, 217, 181, 0.13), transparent 64%), rgba(3, 19, 15, 0.38);
    text-align: center;
  }

  .about-cta>svg {
    width: 34px;
    height: 34px;
    margin-bottom: 18px;
  }

  .about-cta h2 {
    margin-bottom: 8px;
  }

  .about-cta>p:not(.about-eyebrow) {
    margin: 0 0 22px;
    color: var(--about-muted);
  }

  .about-cta .button {
    border-color: var(--about-mint);
    border-radius: 11px;
    background: var(--about-mint);
    color: #06231b;
  }

  @media (max-width: 820px) {
    .about-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-steps article {
      padding-inline: 14px;
    }
  }

  @media (max-width: 600px) {
    .about-page .container {
      width: calc(100% - 32px);
    }

    .about-hero {
      padding-block: 58px 48px;
    }

    .about-hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.6rem);
    }

    .about-facts {
      gap: 9px;
      padding-block: 14px;
    }

    .about-fact {
      min-height: 120px;
      padding: 14px;
    }

    .about-fact strong {
      font-size: 1rem;
    }

    .about-fact span {
      font-size: 0.72rem;
    }

    .about-section {
      padding-block: 50px;
    }

    .about-problem-row {
      grid-template-columns: 1fr;
    }

    .about-problem {
      border-right: 0;
      border-bottom: 1px solid rgba(20, 217, 181, 0.14);
      padding: 15px;
    }

    .about-answer {
      padding: 14px 15px 16px;
    }

    .about-story {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .about-story-mark {
      width: 50px;
      height: 50px;
    }

    .about-values-grid,
    .about-delivery-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .about-info-card,
    .about-detail-card {
      padding: 20px;
    }

    .about-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px 0;
    }

    .about-steps article:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .about-steps article:nth-child(even) {
      padding-right: 0;
    }

    .about-coverage {
      grid-template-columns: 48px 1fr;
      gap: 14px;
    }

    .about-coverage>svg {
      width: 48px;
      height: 48px;
    }

    .about-cta {
      padding: 34px 18px;
    }

    .about-cta h2 {
      font-size: 1.8rem;
    }
  }
</style>
